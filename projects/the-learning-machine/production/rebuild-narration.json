{
  "mode":"absolute",
  "duration":153.6,
  "settings":{"rate":"+22%","pitch":"-1Hz"},
  "sentences":[
    {"id":"r01","start":0.25,"budget":2.75,"text":"把这只猫翻过来，它还是猫。"},
    {"id":"r02","start":3.1,"budget":3.0,"text":"可对机器，为什么曾经这么难？"},
    {"id":"r03","start":6.2,"budget":3.25,"text":"七十年的变化，藏在三道问题里。"},
    {"id":"r04","start":9.6,"budget":3.55,"text":"第一题：能不能把知识，写成规则？"},
    {"id":"r05","start":13.3,"budget":4.85,"text":"一九五六年，达特茅斯让人工智能成为研究领域。"},
    {"id":"r06","start":18.3,"budget":4.05,"text":"尖耳朵，加胡须，就判断是猫。"},
    {"id":"r07","start":22.5,"budget":4.45,"text":"遮住耳朵，规则就失效。现实总有例外。"},
    {"id":"r08","start":27.1,"budget":4.15,"text":"那就换题：别手写答案，让机器从样本里学。"},
    {"id":"r09","start":31.4,"budget":3.95,"text":"先猜，算误差，再调整连接的权重。"},
    {"id":"r10","start":35.5,"budget":4.35,"text":"反向传播，负责高效计算该往哪儿调整。"},
    {"id":"r11","start":40.0,"budget":3.35,"text":"反复练习，错误才有机会减少。"},
    {"id":"r12","start":43.5,"budget":4.35,"text":"记住训练题，不等于学会。得考没见过的题。"},
    {"id":"r13","start":48.0,"budget":3.55,"text":"接着，把简单特征，一层层组合。"},
    {"id":"r14","start":51.7,"budget":3.65,"text":"从边缘，到局部，再到更复杂的模式。"},
    {"id":"r15","start":55.5,"budget":4.35,"text":"二零一二年，深度网络突破了图像识别。"},
    {"id":"r16","start":60.0,"budget":3.95,"text":"数据提供例子，图形处理器负责并行计算。"},
    {"id":"r17","start":64.1,"budget":2.95,"text":"机器，也开始学习怎么选择。"},
    {"id":"r18","start":67.2,"budget":5.15,"text":"阿尔法狗用网络筛选落点、评估局面，再配合搜索。"},
    {"id":"r19","start":72.5,"budget":4.35,"text":"二零一六年，它以四比一战胜李世石。"},
    {"id":"r20","start":77.0,"budget":4.85,"text":"识别和决策有了，怎样处理整句话？"},
    {"id":"r21","start":82.0,"budget":4.05,"text":"二零一七年，变换器架构给出一条新路。"},
    {"id":"r22","start":86.2,"budget":4.05,"text":"小猫追球，它想玩。它指的是谁？"},
    {"id":"r23","start":90.4,"budget":4.45,"text":"注意力，把相关位置的信息，按权重组合。"},
    {"id":"r24","start":95.0,"budget":3.85,"text":"背后，是向量之间的批量计算。"},
    {"id":"r25","start":99.0,"budget":4.05,"text":"第三题：预测下个词元，能学到什么？"},
    {"id":"r26","start":103.2,"budget":4.05,"text":"太阳从，更可能接东方，而不是海底。"},
    {"id":"r27","start":107.4,"budget":4.45,"text":"海量文本训练，让网络积累语言和知识模式。"},
    {"id":"r28","start":112.0,"budget":4.85,"text":"再用指令示范和反馈训练，让它更适合回答人。"},
    {"id":"r29","start":117.0,"budget":3.85,"text":"二零二二年，聊天机器人引发大众关注。"},
    {"id":"r30","start":121.0,"budget":4.85,"text":"文字、图像、声音接起来，就有了多模态交互。"},
    {"id":"r31","start":126.0,"budget":2.85,"text":"但会说，不等于说对。"},
    {"id":"r32","start":129.0,"budget":3.85,"text":"它也会自信地，编出不存在的依据。"},
    {"id":"r33","start":133.0,"budget":4.85,"text":"所以，重要答案要核验，关键决定仍要人负责。"},
    {"id":"r34","start":138.0,"budget":4.85,"text":"从写规则，到学规律，再到与人协作。"},
    {"id":"r35","start":143.0,"budget":4.85,"text":"人工智能的下一步，不只取决于机器能做什么。"},
    {"id":"r36","start":148.0,"budget":4.35,"text":"也取决于，我们问什么，验证什么。"}
  ]
}
