{
  "name": "frame-studio",
  "version": "9.0.0",
  "description": "FRAME Studio：用 AI 制作代码驱动的视频作品",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "frame": "bin/frame.mjs"
  },
  "scripts": {
    "start": "node bin/frame.mjs serve",
    "dev": "node bin/frame.mjs serve --dev",
    "build": "vite build --config web/vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "frame": "node bin/frame.mjs",
    "mcp": "node bin/frame.mjs mcp",
    "format": "prettier --write server web bin src/preview tests --ignore-path .gitignore"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.85.1",
    "@agentclientprotocol/codex-acp": "2.1.1",
    "@agentclientprotocol/sdk": "1.7.0",
    "@babel/parser": "7.28.5",
    "@babylonjs/core": "9.28.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/server": "2.1.0",
    "@types/flubber": "0.4.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "codemirror": "6.0.2",
    "fflate": "0.8.3",
    "ffmpeg-static": "5.3.0",
    "flubber": "0.4.2",
    "gsap": "3.15.0",
    "lottie-web": "5.13.0",
    "lucide-react": "1.48.0",
    "mediabunny": "1.56.1",
    "msedge-tts": "2.0.8",
    "pixi.js": "8.21.0",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.4",
    "sherpa-onnx-node": "1.13.8",
    "signalsmith-stretch": "1.3.2",
    "spessasynth_core": "4.3.22",
    "tar": "7.5.22",
    "three": "0.186.1",
    "tone": "15.1.22",
    "typescript": "7.0.2",
    "unbzip2-stream": "1.4.3",
    "vite": "8.3.1",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "prettier": "3.9.9",
    "vitest": "5.0.2"
  }
}
