# Keep the existing master key when upgrading. Never regenerate it for an existing database.
FRAME_VERSION=4.2.0
FRAME_SPEECH_VERSION=4.2.0
FRAME_DOMAIN=frame.nerviloom.com
FRAME_PUBLIC_URL=https://frame.nerviloom.com
FRAME_PROXY_NETWORK=caddy_caddy
FRAME_HOST_DATA=/opt/stacks/frame/data
FRAME_TASK_CONCURRENCY=2
FRAME_TASK_TIMEOUT_SECONDS=21600
FRAME_MIN_FREE_BYTES=1073741824
POSTGRES_PASSWORD=replace-with-random-url-safe-password
FRAME_MASTER_KEY=replace-with-64-hex-characters
FRAME_ADMIN_PASSWORD=replace-with-at-least-14-characters
