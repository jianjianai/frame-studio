# syntax=docker/dockerfile:1.14
FROM node:24-bookworm-slim AS base
RUN apt-get update && apt-get install -y --no-install-recommends git git-lfs gh ffmpeg chromium fonts-noto-cjk ca-certificates tini && rm -rf /var/lib/apt/lists/*
# T3's upstream lock is independent of FRAME's package manager and application image.
RUN npm install -g pnpm@11.10.0 @openai/codex@0.158.0 @anthropic-ai/claude-code@2.1.283
FROM base AS build
WORKDIR /opt/t3-build
COPY scripts/build-t3.mjs ./scripts/build-t3.mjs
COPY server/local-tools.mjs ./server/local-tools.mjs
COPY integrations/t3-code/ ./integrations/t3-code/
COPY --from=t3_bundle / /opt/t3-bundle/
RUN node scripts/build-t3.mjs --prebuilt=/opt/t3-bundle --runtime=/opt/t3 && mkdir -p /opt/t3/bin && \
    cp integrations/t3-code/bin/tool.mjs /opt/t3/bin/codex && cp integrations/t3-code/bin/tool.mjs /opt/t3/bin/claude && \
    chmod 755 /opt/t3/bin/codex /opt/t3/bin/claude
FROM base
COPY --from=build /opt/t3/ /opt/t3/
COPY scripts/start-t3.mjs /opt/t3/start.mjs
ENV NODE_ENV=production FRAME_DATA=/data FRAME_T3_ROOT=/opt/t3 FRAME_BROWSER=/usr/bin/chromium T3CODE_HOST=0.0.0.0 T3CODE_PORT=3773
ARG REVISION=development
LABEL org.opencontainers.image.source="https://github.com/jianjianai/frame-studio" org.opencontainers.image.revision=$REVISION org.opencontainers.image.title="FRAME T3 Code native runtime"
WORKDIR /opt/t3
EXPOSE 3773
ENTRYPOINT ["/usr/bin/tini","--"]
USER 1000:1000
CMD ["node","start.mjs"]
