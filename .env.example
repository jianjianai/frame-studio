# Copy with `pnpm film mcp-remote init`; secrets are generated locally without printing.
# Stable public origin. The AI client endpoint is this URL + /mcp.
FRAME_MCP_PUBLIC_URL=https://mcp.example.com
FRAME_MCP_HOST=127.0.0.1
FRAME_MCP_PORT=8787
# Explicit project ids (including permitted new ids), or * for this entire workspace.
FRAME_MCP_PROJECTS=paper-wings,sunny-rail,tiny-seed
FRAME_MCP_READ_ONLY=false
FRAME_MCP_AUTH_MODE=both
FRAME_MCP_BEARER_TOKEN=REPLACE_WITH_RANDOM_TOKEN
FRAME_MCP_BEARER_SCOPES="frame:read frame:write"
# Owner password, used only on FRAME's OAuth consent page.
FRAME_OAUTH_ADMIN_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
# Exact callbacks shown by your external AI client; comma-separated, no wildcard.
FRAME_OAUTH_REDIRECT_URIS=https://your-ai.example/oauth/callback
# Optional fixed clients; otherwise the AI client uses dynamic registration.
# FRAME_OAUTH_CLIENTS='[{"client_id":"my-ai","client_name":"My AI","redirect_uris":["https://your-ai.example/oauth/callback"],"token_endpoint_auth_method":"none"}]'
FRAME_OAUTH_ACCESS_TTL=900
FRAME_OAUTH_REFRESH_TTL=2592000
FRAME_MCP_JOB_TIMEOUT=600
FRAME_MCP_MAX_PRINCIPALS=32
# Only needed by clients that send a browser Origin header. Exact origins, no *.
FRAME_MCP_ALLOWED_ORIGINS=
# In Cloudflare, route the SAME public hostname to http://127.0.0.1:8787.
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_TOKEN=
# Full path if cloudflared is not on PATH. Never paste the tunnel token here.
CLOUDFLARED_PATH=cloudflared
CLOUDFLARE_TUNNEL_PROTOCOL=auto

# Optional speech providers. Can instead be set in projects/<id>/.env.
# A project selects providers in production/speech.json; Edge needs no service key.
# OPENAI_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# Custom OpenAI-compatible URL: reference its env name with baseUrlEnv in speech.json.
# FILM_TTS_BASE_URL=http://127.0.0.1:8880/v1
