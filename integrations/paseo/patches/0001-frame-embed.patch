+import { describe, expect, it } from "vitest";
+import type { AsyncStorageStatic } from "@react-native-async-storage/async-storage";
+import { createScopedAsyncStorage } from "./storage-model";
+
+function memoryStorage(): AsyncStorageStatic {
+  const values = new Map<string, string>();
+  const api: AsyncStorageStatic = {
+    async getItem(key, callback) {
+      const value = values.get(key) ?? null;
+      callback?.(null, value);
+      return value;
+    },
+    async setItem(key, value, callback) {
+      values.set(key, value);
+      callback?.(null);
+    },
+    async removeItem(key, callback) {
+      values.delete(key);
+      callback?.(null);
+    },
+    async mergeItem(key, value, callback) {
+      values.set(
+        key,
+        JSON.stringify({ ...JSON.parse(values.get(key) ?? "{}"), ...JSON.parse(value) }),
+      );
+      callback?.(null);
+    },
+    async clear(callback) {
+      values.clear();
+      callback?.(null);
+    },
+    async getAllKeys(callback) {
+      const keys = Array.from(values.keys());
+      callback?.(null, keys);
+      return keys;
+    },
+    flushGetRequests() {},
+    async multiGet(keys, callback) {
+      const rows: [string, string | null][] = keys.map((key) => [key, values.get(key) ?? null]);
+      callback?.(null, rows);
+      return rows;
+    },
+    async multiSet(rows, callback) {
+      for (const [key, value] of rows) values.set(key, value);
+      callback?.(null);
+    },
+    async multiRemove(keys, callback) {
+      for (const key of keys) values.delete(key);
+      callback?.(null);
+    },
+    async multiMerge(rows, callback) {
+      for (const [key, value] of rows) await api.mergeItem(key, value);
+      callback?.(null);
+    },
+  };
+  return api;
+}
+
+describe("Frame scoped native storage", () => {
+  it("keeps identical native keys isolated by both user and work, and clears only this namespace", async () => {
+    const raw = memoryStorage();
+    const current = createScopedAsyncStorage(raw, "frame:userA:work1:");
+    const otherWork = createScopedAsyncStorage(raw, "frame:userA:work2:");
+    const otherUser = createScopedAsyncStorage(raw, "frame:userB:work1:");
+    await raw.setItem("default-Paseo-preferences", "untouched");
+    await current.setItem("hosts", "current");
+    await otherWork.setItem("hosts", "other work");
+    await otherUser.setItem("hosts", "other user");
+    expect(await current.getAllKeys()).toEqual(["hosts"]);
+    expect(await current.multiGet(["hosts", "missing"])).toEqual([
+      ["hosts", "current"],
+      ["missing", null],
+    ]);
+    await current.clear();
+    expect(await current.getAllKeys()).toEqual([]);
+    expect(await otherWork.getItem("hosts")).toBe("other work");
+    expect(await otherUser.getItem("hosts")).toBe("other user");
+    expect(await raw.getItem("default-Paseo-preferences")).toBe("untouched");
+  });
+  it("scopes batch writes, JSON merges, and removal using logical native keys", async () => {
+    const raw = memoryStorage();
+    const current = createScopedAsyncStorage(raw, "frame:user:work:");
+    await current.multiSet([
+      ["one", '{"a":1}'],
+      ["two", '{"b":2}'],
+    ]);
+    await current.multiMerge([["one", '{"c":3}']]);
+    expect(await current.getItem("one")).toBe('{"a":1,"c":3}');
+    await current.multiRemove(["two"]);
+    expect(await current.getAllKeys()).toEqual(["one"]);
+    expect(await raw.getItem("one")).toBeNull();
+    expect(await raw.getItem("frame:user:work:one")).toBe('{"a":1,"c":3}');
+  });
+  it("leaves the native/default unscoped adapter intact", () => {
+    const raw = memoryStorage();
+    expect(createScopedAsyncStorage(raw, "")).toBe(raw);
+  });
+});
