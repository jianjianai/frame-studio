@@ -0,0 +1,52 @@
+import AsyncStorage from "@react-native-async-storage/async-storage";
+import { useSessionStore } from "@/stores/session-store";
+import { getFrameBootstrap } from "./bootstrap";
+import { getFrameBridge } from "./bridge";
+import { FrameEmbedError } from "./bootstrap-model";
+import { FrameSubmissionRegistry, fingerprintFrameSubmission } from "./submission-model";
+import type { FramePrepareMessageInput, FramePreparedMessage } from "./submission";
+
+let registry: FrameSubmissionRegistry | null = null;
+function getRegistry(): FrameSubmissionRegistry {
+  const config = getFrameBootstrap();
+  const bridge = getFrameBridge();
+  if (!config || !bridge)
+    throw new FrameEmbedError("bridge_missing", "The Frame work is not connected.");
+  registry ??= new FrameSubmissionRegistry(config.workId, AsyncStorage, {
+    readContext: () => bridge.request("context.read", {}),
+    freeze: (input) => bridge.request("freeze.submit", input),
+  });
+  return registry;
+}
+export async function prepareFrameMessage(
+  input: FramePrepareMessageInput,
+): Promise<FramePreparedMessage> {
+  const config = getFrameBootstrap();
+  if (!config) return { messageId: input.messageId, attachment: null };
+  const agent = useSessionStore.getState().sessions[config.serverId]?.agents.get(input.agentId);
+  if (!agent || !agent.workspaceId) {
+    throw new FrameEmbedError("agent_scope", "The message must belong to the current Frame work.");
+  }
+  const result = await getRegistry().prepare({
+    agentId: input.agentId,
+    prompt: input.text,
+    profileId: agent.provider,
+    model: agent.model,
+    activeTurnBehavior: input.activeTurnBehavior,
+    attachmentsFingerprint: await fingerprintFrameSubmission(input.wireContent),
+  });
+  return { messageId: result.messageId, attachment: result.attachment ?? null };
+}
+export async function acceptFrameMessage(agentId: string, messageId: string): Promise<void> {
+  if (!getFrameBootstrap()) return;
+  // A native accepted receipt stays accepted if local storage cleanup fails.
+  try {
+    await getRegistry().accepted(agentId, messageId);
+  } catch (error) {
+    console.error("[Frame] Could not clear an accepted message receipt", error);
+  }
+  const bridge = getFrameBridge();
+  if (!bridge) return;
+  // Acceptance is a refresh hint; Frame publication still requires its durable validation proof.
+  void bridge.request("message.accepted", { agentId, messageId }).catch(() => {});
+}
