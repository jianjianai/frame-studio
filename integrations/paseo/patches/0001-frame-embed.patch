+import { describe, expect, it } from "vitest";
+import {
+  FramePortMessageSchema,
+  FramePortRequestSchema,
+  FrameReviewContextSchema,
+} from "../../../../plugin-examples/frame/shared/bridge";
+const id = "c91d658b-c86e-44e7-b5b2-96a94a399ade";
+describe("Frame MessagePort strict protocol", () => {
+  it("parses both response outcomes without duplicate discriminators", () => {
+    expect(
+      FramePortMessageSchema.parse({ type: "response", id, ok: true, payload: { time: 2 } }),
+    ).toMatchObject({ ok: true });
+    expect(
+      FramePortMessageSchema.parse({
+        type: "response",
+        id,
+        ok: false,
+        error: { code: "expired", message: "Retry" },
+      }),
+    ).toMatchObject({ ok: false });
+    expect(
+      FramePortMessageSchema.safeParse({ type: "response", id, ok: false, payload: {} }).success,
+    ).toBe(false);
+    expect(
+      FramePortMessageSchema.parse({ type: "connected", version: 1, workId: id, nonce: "fixture" }),
+    ).toMatchObject({ type: "connected" });
+  });
+  it("rejects unknown operations, extra API targets and malformed review ranges", () => {
+    expect(
+      FramePortRequestSchema.safeParse({ type: "request", id, op: "fetch.arbitrary", payload: {} })
+        .success,
+    ).toBe(false);
+    expect(
+      FramePortRequestSchema.safeParse({
+        type: "request",
+        id,
+        op: "context.read",
+        payload: {},
+        url: "/credentials",
+      }).success,
+    ).toBe(false);
+    for (const context of [{ start: 1 }, { end: 2 }, { start: 2, end: 1 }, { start: 2, end: 2 }]) {
+      expect(FrameReviewContextSchema.safeParse(context).success).toBe(false);
+    }
+    expect(FrameReviewContextSchema.parse({ start: 1, end: 2 })).toEqual({ start: 1, end: 2 });
+  });
+});
