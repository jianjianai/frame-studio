new file mode 100644
index 0000000000000000000000000000000000000000..ef98b63344c3733adfa3399654a7097f413e26a0
--- /dev/null
+++ b/packages/app/frame-router-transformer.cjs
@@ -0,0 +1,18 @@
+const upstream = require("@expo/metro-config/babel-transformer");
+const ROUTER_FILES = new Set([
+  "getStateFromPath-forks.js",
+  "getPathFromState-forks.js",
+  "getPathFromState.js",
+]);
+module.exports.transform = function transform(input) {
+  const filename = input.filename.replaceAll("\\", "/");
+  const basename = filename.slice(filename.lastIndexOf("/") + 1);
+  const isRouterFile = filename.includes("/expo-router/build/fork/") && ROUTER_FILES.has(basename);
+  if (!isRouterFile) return upstream.transform(input);
+  const src = input.src.replaceAll(
+    "baseUrl = process.env.EXPO_BASE_URL",
+    "baseUrl = (globalThis.__FRAME_PASEO_ROUTE_BASE__ ?? process.env.EXPO_BASE_URL)",
+  );
+  if (src === input.src) throw new Error("The pinned Expo Router base URL contract changed.");
+  return upstream.transform({ ...input, src });
+};
