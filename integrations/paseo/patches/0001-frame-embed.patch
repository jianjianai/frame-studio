@@ -0,0 +1,29 @@
+import { getFrameBootstrap } from "./bootstrap";
+import { frameStorageNamespace } from "./bootstrap-model";
+import { FrameEmbedError } from "./bootstrap-model";
+export function frameInitialMessageId(draftId: string): string {
+  const config = getFrameBootstrap();
+  if (!config) return `${draftId}:initial-message`;
+  const key = frameStorageNamespace(config) + "initial-message-ids";
+  let rows: Array<{ id: string; messageId: string }>;
+  try {
+    rows = JSON.parse(localStorage.getItem(key) ?? "[]");
+    if (
+      !Array.isArray(rows) ||
+      rows.some((row) => typeof row.id !== "string" || typeof row.messageId !== "string")
+    )
+      throw new Error("Invalid initial-message storage");
+    const existing = rows.find((row) => row.id === draftId);
+    if (existing) return existing.messageId;
+    const messageId = crypto.randomUUID();
+    rows.push({ id: draftId, messageId });
+    if (rows.length > 128) rows.splice(0, rows.length - 128);
+    localStorage.setItem(key, JSON.stringify(rows));
+    return messageId;
+  } catch {
+    throw new FrameEmbedError(
+      "creation_storage",
+      "The browser could not persist the new conversation identity. Enable storage for Frame and retry.",
+    );
+  }
+}
