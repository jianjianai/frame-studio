@@ -0,0 +1,33 @@
+import { parseFrameBootstrap, frameStorageNamespace, frameHistoryUrl } from "./bootstrap-model";
+import type { FrameBootstrap } from "../../../../plugin-examples/frame/shared/bridge";
+
+function readBootstrap(): FrameBootstrap | null {
+  if (typeof window === "undefined") return null;
+  return parseFrameBootstrap({
+    value: Reflect.get(globalThis, "__PASEO_FRAME_EMBED__"),
+    origin: window.location.origin,
+    pathname: window.location.pathname,
+  });
+}
+const bootstrap = readBootstrap();
+if (bootstrap) {
+  Reflect.set(globalThis, "__FRAME_PASEO_ROUTE_BASE__", bootstrap.basePath.slice(0, -1));
+  const config = bootstrap;
+  const push = window.history.pushState.bind(window.history);
+  const replace = window.history.replaceState.bind(window.history);
+  window.history.pushState = (data, unused, url) =>
+    push(data, unused, frameHistoryUrl(url, config, window.location.href));
+  window.history.replaceState = (data, unused, url) =>
+    replace(data, unused, frameHistoryUrl(url, config, window.location.href));
+}
+export function getFrameBootstrap(): FrameBootstrap | null {
+  return bootstrap;
+}
+export function frameStorageName(name: string): string {
+  if (!bootstrap) return name;
+  return frameStorageNamespace(bootstrap) + name;
+}
+export function getFrameBrowserOrigin(): string | null {
+  if (typeof window === "undefined") return null;
+  return window.location.origin;
+}
