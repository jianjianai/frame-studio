diff --git a/packages/app/src/frame/creation.web.ts b/packages/app/src/frame/creation.web.ts
new file mode 100644
index 0000000000000000000000000000000000000000..12f277206324e7d7fbc75ccb259dc8c3f9873b45
--- /dev/null
+++ b/packages/app/src/frame/creation.web.ts
@@ -0,0 +1,209 @@
+import AsyncStorage from "@react-native-async-storage/async-storage";
+import type {
+  DaemonClient,
+  CreateAgentRequestOptions,
+  CreateWorkspaceRequestOptions,
+} from "@getpaseo/client/internal/daemon-client";
+import type { AgentSnapshotPayload, WorkspaceDescriptorPayload } from "@getpaseo/protocol/messages";
+import { getFrameBootstrap } from "./bootstrap";
+import { getFrameBridge } from "./bridge";
+import { FrameCreationRegistry } from "./creation-model";
+import { fingerprintFrameSubmission } from "./submission-model";
+import { FrameEmbedError } from "./bootstrap-model";
+const adaptedClients = new WeakSet<DaemonClient>();
+function workspaceCreationKey(options: CreateWorkspaceRequestOptions, requestId?: string) {
+  return options.idempotencyKey ?? options.agent?.clientMessageId ?? requestId ?? options.requestId;
+}
+function publicIntent(value: unknown): unknown {
+  return JSON.parse(JSON.stringify(value));
+}
+export function installFrameCreationAdapter(client: DaemonClient): DaemonClient {
+  const config = getFrameBootstrap();
+  if (!config || adaptedClients.has(client)) return client;
+  adaptedClients.add(client);
+  const nativeAgent = client.createAgent.bind(client),
+    nativeWorkspace = client.createWorkspace.bind(client);
+  const registry = new FrameCreationRegistry(config.workId, AsyncStorage, async () => {
+    const bridge = getFrameBridge();
+    if (!bridge) throw new FrameEmbedError("bridge_missing", "The Frame work is not connected.");
+    return bridge.request("context.read", {});
+  });
+  const context = () => {
+    const bridge = getFrameBridge();
+    if (!bridge) throw new FrameEmbedError("bridge_missing", "The Frame work is not connected.");
+    return bridge;
+  };
+  async function boundWorkspace(): Promise<WorkspaceDescriptorPayload> {
+    let cursor: string | undefined;
+    for (let page = 0; page < 20; page++) {
+      const result = await client.fetchWorkspaces({
+        page: { limit: 200, ...(cursor ? { cursor } : {}) },
+      });
+      const workspace = result.entries.find((item) => item.id === config!.workspaceId);
+      if (workspace) return workspace;
+      if (!result.pageInfo.hasMore || !result.pageInfo.nextCursor) break;
+      cursor = result.pageInfo.nextCursor;
+    }
+    throw new FrameEmbedError(
+      "workspace_missing",
+      "The bound Frame workspace is unavailable. Reopen this work from Frame.",
+    );
+  }
+  async function send(
+    agentId: string,
+    frozen: {
+      messageId: string;
+      attachment?: NonNullable<CreateAgentRequestOptions["attachments"]>[number];
+    },
+    options: CreateAgentRequestOptions,
+  ) {
+    await client.sendMessage(agentId, options.initialPrompt ?? "", {
+      messageId: frozen.messageId,
+      ...(options.images?.length ? { images: options.images } : {}),
+      attachments: [
+        ...(options.attachments ?? []),
+        ...(frozen.attachment ? [frozen.attachment] : []),
+      ],
+    });
+    void context()
+      .request("message.accepted", { agentId, messageId: frozen.messageId })
+      .catch(() => {});
+  }
+  async function createAgent(
+    options: CreateAgentRequestOptions,
+    capturedContext?: Promise<unknown>,
+  ): Promise<AgentSnapshotPayload> {
+    const captured = capturedContext ?? context().request("context.read", {});
+    void captured.catch(() => {});
+    const root = await boundWorkspace();
+    const requested = options.workspaceId ?? root.id;
+    const workspaces = await client.fetchWorkspaces({
+      filter: { projectId: root.projectId },
+      page: { limit: 200 },
+    });
+    const workspace = workspaces.entries.find(
+      (item) => item.id === requested && item.projectRootPath === root.projectRootPath,
+    );
+    if (!workspace)
+      throw new FrameEmbedError(
+        "workspace_scope",
+        "Create conversations in this work or its managed worktrees. To use another project, open it in Frame.",
+      );
+    const cwd = options.config?.cwd ?? options.cwd ?? workspace.workspaceDirectory;
+    if (cwd !== workspace.workspaceDirectory)
+      throw new FrameEmbedError(
+        "workspace_scope",
+        "This conversation must use the selected Frame workspace directory.",
+      );
+    const scoped = { ...options, workspaceId: workspace.id };
+    if (!options.initialPrompt && !options.images?.length && !options.attachments?.length)
+      return nativeAgent(scoped);
+    const key = options.idempotencyKey ?? options.clientMessageId ?? options.requestId;
+    if (!key)
+      throw new FrameEmbedError(
+        "creation_key",
+        "The new conversation needs a stable native creation key. Reopen the new conversation tab and retry.",
+      );
+    return registry.run(key, publicIntent(scoped), {
+      prompt: options.initialPrompt ?? "",
+      messageId: options.clientMessageId,
+      context: captured,
+      attachmentsFingerprint: await fingerprintFrameSubmission({
+        images: options.images ?? [],
+        attachments: options.attachments ?? [],
+      }),
+      create: async (agentId) => {
+        const {
+          initialPrompt: _,
+          clientMessageId: __,
+          images: ___,
+          attachments: ____,
+          onEvent,
+          ...blank
+        } = scoped;
+        const result = await nativeAgent({ ...blank, agentId, idempotencyKey: key, onEvent });
+        return { agentId: result.id, profileId: result.provider, model: result.model, result };
+      },
+      freeze: (input) => context().request("freeze.submit", input),
+      send: (agentId, frozen) => send(agentId, frozen, options),
+    });
+  }
+  client.createAgent = createAgent;
+  client.createWorkspace = async (options: CreateWorkspaceRequestOptions, requestId?: string) => {
+    const captured = options.agent ? context().request("context.read", {}) : undefined;
+    void captured?.catch(() => {});
+    const root = await boundWorkspace();
+    const source = options.source;
+    const sourcePath = source.kind === "directory" ? source.path : source.cwd;
+    if (sourcePath !== root.projectRootPath && sourcePath !== root.workspaceDirectory)
+      throw new FrameEmbedError(
+        "workspace_scope",
+        "This preview is bound to one Frame work. Open another work in Frame to change projects.",
+      );
+    if (source.kind === "directory") {
+      const agent = options.agent
+        ? await createAgent(
+            {
+              ...options.agent,
+              workspaceId: root.id,
+              idempotencyKey: workspaceCreationKey(options, requestId),
+            },
+            captured,
+          )
+        : undefined;
+      return {
+        workspace: root,
+        agent,
+        setupTerminalId: null,
+        error: null,
+        requestId: requestId ?? options.requestId ?? crypto.randomUUID(),
+      };
+    }
+    if (!options.agent) return nativeWorkspace(options, requestId);
+    const original = options.agent;
+    const key = workspaceCreationKey(options, requestId);
+    if (!key)
+      throw new FrameEmbedError("creation_key", "The worktree needs a stable native creation key.");
+    return registry.run(key, publicIntent(options), {
+      prompt: original.initialPrompt ?? "",
+      messageId: original.clientMessageId,
+      context: captured,
+      attachmentsFingerprint: await fingerprintFrameSubmission({
+        images: original.images ?? [],
+        attachments: original.attachments ?? [],
+      }),
+      create: async (agentId) => {
+        const {
+          initialPrompt: _,
+          clientMessageId: __,
+          images: ___,
+          attachments: ____,
+          ...blank
+        } = original;
+        const result = await nativeWorkspace(
+          {
+            ...options,
+            firstAgentContext: undefined,
+            agent: { ...blank, agentId },
+            idempotencyKey: key,
+          },
+          requestId,
+        );
+        if (!result.agent)
+          throw new FrameEmbedError(
+            "creation_failed",
+            result.error ?? "The native worktree did not create its conversation.",
+          );
+        return {
+          agentId: result.agent.id,
+          profileId: result.agent.provider,
+          model: result.agent.model,
+          result,
+        };
+      },
+      freeze: (input) => context().request("freeze.submit", input),
+      send: (agentId, frozen) => send(agentId, frozen, original),
+    });
+  };
+  return client;
+}
