index 0000000000000000000000000000000000000000..a3253e269c3a5b827ed4b1ff5aa14a630aaccd35
--- /dev/null
+++ b/packages/app/src/frame/bootstrap-model.test.ts
@@ -0,0 +1,97 @@
+import { describe, expect, it } from "vitest";
+import {
+  parseFrameBootstrap,
+  frameBrowserRoute,
+  frameLogicalRoute,
+  frameStorageNamespace,
+  frameWebSocketUrl,
+  frameHistoryUrl,
+} from "./bootstrap-model";
+const config = {
+  version: 1,
+  workId: "c91d658b-c86e-44e7-b5b2-96a94a399ade",
+  userScope: "user-scope-123456",
+  nonce: "one-preview-authorization-123456",
+  basePath: "/paseo/c91d658b-c86e-44e7-b5b2-96a94a399ade/",
+  parentOrigin: "https://frame.test",
+  serverId: "daemon-1",
+  workspaceId: "/workspace",
+  label: "Frame work",
+} as const;
+describe("Frame embedded work scope", () => {
+  it("keeps all routes and transport inside the exact current work", () => {
+    const parsed = parseFrameBootstrap({
+      value: config,
+      origin: config.parentOrigin,
+      pathname: config.basePath + "h/daemon-1",
+    });
+    expect(parsed).toEqual(config);
+    expect(frameLogicalRoute(config.basePath + "h/daemon-1?open=agent:a#x", parsed)).toBe(
+      "/h/daemon-1?open=agent:a#x",
+    );
+    expect(frameBrowserRoute("/settings", parsed)).toBe(config.basePath + "settings");
+    expect(frameBrowserRoute(config.basePath + "settings", parsed)).toBe(
+      config.basePath + "settings",
+    );
+    expect(
+      frameWebSocketUrl({ config, origin: config.parentOrigin, endpoint: "frame.test:443" }),
+    ).toBe("wss://frame.test" + config.basePath + "ws");
+    expect(frameStorageNamespace(config)).toBe(
+      "frame-paseo:user-scope-123456:" + config.workId + ":",
+    );
+  });
+  it("rejects crossed works, parent origins, routes and daemon addresses", () => {
+    expect(() =>
+      parseFrameBootstrap({
+        value: config,
+        origin: "https://foreign.test",
+        pathname: config.basePath,
+      }),
+    ).toThrow("different work or origin");
+    expect(() =>
+      parseFrameBootstrap({
+        value: config,
+        origin: config.parentOrigin,
+        pathname: "/paseo/other/",
+      }),
+    ).toThrow("different work or origin");
+    expect(() =>
+      parseFrameBootstrap({
+        value: { ...config, basePath: "/paseo/../" },
+        origin: config.parentOrigin,
+        pathname: config.basePath,
+      }),
+    ).toThrow("different work or origin");
+    expect(() => frameBrowserRoute("//foreign.test", config)).toThrow("inside this work");
+    expect(() =>
+      frameWebSocketUrl({ config, origin: config.parentOrigin, endpoint: "foreign.test:443" }),
+    ).toThrow("own daemon");
+    expect(() =>
+      frameWebSocketUrl({ config, origin: config.parentOrigin, endpoint: "frame.test:443/other" }),
+    ).toThrow("own daemon");
+  });
+  it("leaves standard Paseo and native routes unchanged", () => {
+    expect(
+      parseFrameBootstrap({ value: undefined, origin: config.parentOrigin, pathname: "/" }),
+    ).toBeNull();
+    expect(frameBrowserRoute("/settings", null)).toBe("/settings");
+    expect(frameLogicalRoute("/h/host", null)).toBe("/h/host");
+  });
+});
+
+it("preserves the embed nonce across native navigation and rejects a foreign work or origin", () => {
+  const current = config.parentOrigin + config.basePath + "?frameNonce=" + config.nonce;
+  expect(frameHistoryUrl("/settings/general", config, current)).toBe(
+    config.basePath + "settings/general?frameNonce=" + config.nonce,
+  );
+  expect(frameHistoryUrl(config.basePath + "h/daemon-1?open=agent%3Aone#x", config, current)).toBe(
+    config.basePath + "h/daemon-1?open=agent%3Aone&frameNonce=" + config.nonce + "#x",
+  );
+  expect(() => frameHistoryUrl("https://foreign.test/", config, current)).toThrow(
+    "inside this work",
+  );
+  expect(() => frameHistoryUrl("/paseo/another/settings", config, current)).toThrow(
+    "different work",
+  );
+  expect(frameHistoryUrl(null, config, current)).toBeNull();
+});
diff --git a/packages/app/src/frame/bootstrap-model.ts b/packages/app/src/frame/bootstrap-model.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a0da4712a1e5d90630579405088a3f4a114772d4
--- /dev/null
+++ b/packages/app/src/frame/bootstrap-model.ts
@@ -0,0 +1,104 @@
+import {
+  FrameBootstrapSchema,
+  type FrameBootstrap,
+} from "../../../../plugin-examples/frame/shared/bridge";
+
+export interface FrameBootstrapInput {
+  value: unknown;
+  origin: string;
+  pathname: string;
+}
+export class FrameEmbedError extends Error {
+  constructor(
+    public readonly code: string,
+    message: string,
+  ) {
+    super(message);
+    this.name = "FrameEmbedError";
+  }
+}
+export function parseFrameBootstrap(input: FrameBootstrapInput): FrameBootstrap | null {
+  if (input.value === undefined) return null;
+  const parsed = FrameBootstrapSchema.safeParse(input.value);
+  if (!parsed.success)
+    throw new FrameEmbedError("invalid_bootstrap", "The Frame preview connection is invalid.");
+  const config = parsed.data;
+  const expectedPath = `/paseo/${config.workId}/`;
+  const matchesPath = config.basePath === expectedPath && input.pathname.startsWith(expectedPath);
+  if (!matchesPath || config.parentOrigin !== input.origin) {
+    throw new FrameEmbedError(
+      "invalid_scope",
+      "The Frame preview belongs to a different work or origin.",
+    );
+  }
+  return config;
+}
+export function frameStorageNamespace(config: FrameBootstrap): string {
+  return `frame-paseo:${config.userScope}:${config.workId}:`;
+}
+export function frameLogicalRoute(route: string, config: FrameBootstrap | null): string {
+  if (!config) return route;
+  const prefix = config.basePath.slice(0, -1);
+  if (route === prefix || route.startsWith(prefix + "?") || route.startsWith(prefix + "#")) {
+    return "/" + route.slice(prefix.length);
+  }
+  if (route.startsWith(config.basePath)) return "/" + route.slice(config.basePath.length);
+  return route;
+}
+export function frameBrowserRoute(route: string, config: FrameBootstrap | null): string {
+  if (!config) return route;
+  const logical = frameLogicalRoute(route, config);
+  if (!logical.startsWith("/") || logical.startsWith("//")) {
+    throw new FrameEmbedError("invalid_route", "The Frame route must stay inside this work.");
+  }
+  return config.basePath.slice(0, -1) + logical;
+}
+export function frameWebSocketUrl(input: {
+  config: FrameBootstrap;
+  origin: string;
+  endpoint: string;
+}): string {
+  const origin = new URL(input.origin);
+  const endpoint = new URL("http://" + input.endpoint);
+  const defaultPort = origin.protocol === "https:" ? "443" : "80";
+  const matchesHost = endpoint.hostname === origin.hostname;
+  const matchesPort = (endpoint.port || defaultPort) === (origin.port || defaultPort);
+  const plainEndpoint =
+    endpoint.pathname === "/" &&
+    !endpoint.username &&
+    !endpoint.password &&
+    !endpoint.search &&
+    !endpoint.hash;
+  if (!matchesHost || !matchesPort || !plainEndpoint) {
+    throw new FrameEmbedError(
+      "invalid_endpoint",
+      "This Frame preview can connect only to its own daemon.",
+    );
+  }
+  const url = new URL("ws", origin.origin + input.config.basePath);
+  url.protocol = origin.protocol === "https:" ? "wss:" : "ws:";
+  return url.href;
+}
+
+export function frameHistoryUrl(
+  value: string | URL | null | undefined,
+  config: FrameBootstrap,
+  currentHref: string,
+): string | null | undefined {
+  if (value === undefined || value === null) return value;
+  const current = new URL(currentHref);
+  const target = new URL(String(value), current);
+  if (target.origin !== current.origin || target.username || target.password) {
+    throw new FrameEmbedError("invalid_route", "The Frame route must stay inside this work.");
+  }
+  if (
+    target.pathname.startsWith("/paseo/") &&
+    target.pathname !== config.basePath.slice(0, -1) &&
+    !target.pathname.startsWith(config.basePath)
+  ) {
+    throw new FrameEmbedError("invalid_route", "The Frame route belongs to a different work.");
+  }
+  target.pathname = frameBrowserRoute(target.pathname, config);
+  target.searchParams.set("frameNonce", config.nonce);
+  return target.pathname + target.search + target.hash;
+}
