+import { describe, expect, it } from "vitest";
+import { FrameSubmissionRegistry, fingerprintFrameSubmission } from "./submission-model";
+import type { FrameFreezeInput } from "../../../../plugin-examples/frame/shared/bridge";
+const workId = "c91d658b-c86e-44e7-b5b2-96a94a399ade";
+function storage() {
+  const rows = new Map<string, string>();
+  return {
+    async getItem(key: string) {
+      return rows.get(key) ?? null;
+    },
+    async setItem(key: string, value: string) {
+      rows.set(key, value);
+    },
+  };
+}
+const input = {
+  agentId: "agent-1",
+  prompt: "change this frame",
+  profileId: "codex",
+  model: "test-model",
+  attachmentsFingerprint: "a".repeat(64),
+};
+function response(request: FrameFreezeInput) {
+  return {
+    version: 1,
+    workId,
+    agentId: request.agentId,
+    messageId: request.messageId,
+    intentHash: "b".repeat(64),
+    context: request.context,
+    reviewReference: { status: "unversioned" },
+    attachment: {
+      type: "text",
+      mimeType: "text/plain",
+      title: "Frame reference",
+      text: JSON.stringify(request.context),
+    },
+  };
+}
+describe("Frame frozen native submission", () => {
+  it("reuses the original time, assets and message ID after a lost freeze response and reload", async () => {
+    const store = storage();
+    const requests: FrameFreezeInput[] = [];
+    let time = 5;
+    const broker = {
+      async readContext() {
+        return { time, assets: ["070de48f-9b6b-4a73-b6f8-11eaa24e5a80"] };
+      },
+      async freeze(request: FrameFreezeInput) {
+        requests.push(structuredClone(request));
+        if (requests.length === 1) throw new Error("lost response");
+        return response(request);
+      },
+    };
+    const first = new FrameSubmissionRegistry(workId, store, broker);
+    await expect(first.prepare(input)).rejects.toThrow("lost response");
+    time = 10;
+    const reloaded = new FrameSubmissionRegistry(workId, store, broker);
+    const accepted = await reloaded.prepare(input);
+    expect(requests[1]).toEqual(requests[0]);
+    expect(accepted.context.time).toBe(5);
+    expect(await reloaded.prepare(input)).toEqual(accepted);
+    expect(requests).toHaveLength(2);
+    await reloaded.accepted(input.agentId, accepted.messageId);
+    const next = await reloaded.prepare(input);
+    expect(next.messageId).not.toBe(accepted.messageId);
+    expect(next.context.time).toBe(10);
+  });
+  it("rejects a response from a different work and preserves concurrent new messages", async () => {
+    const store = storage();
+    const registry = new FrameSubmissionRegistry(workId, store, {
+      async readContext() {
+        return { time: 3 };
+      },
+      async freeze(request) {
+        return { ...response(request), workId: "ffbc972e-22c1-401e-8611-9c3c34f655a0" };
+      },
+    });
+    await expect(registry.prepare(input)).rejects.toThrow("different work or agent");
+    const good = new FrameSubmissionRegistry(workId, store, {
+      async readContext() {
+        return { time: 8 };
+      },
+      async freeze(request) {
+        return response(request);
+      },
+    });
+    const [original, newer] = await Promise.all([
+      good.prepare(input),
+      good.prepare({ ...input, prompt: "a new message" }),
+    ]);
+    expect(original.context.time).toBe(3);
+    expect(newer.context.time).toBe(8);
+    expect(original.messageId).not.toBe(newer.messageId);
+  });
+  it("keeps the frozen selection and receipt after the native model picker changes", async () => {
+    const store = storage();
+    const requests: FrameFreezeInput[] = [];
+    const broker = {
+      async readContext() {
+        return { time: 5 };
+      },
+      async freeze(request: FrameFreezeInput) {
+        requests.push(structuredClone(request));
+        if (requests.length === 1) throw new Error("lost freeze response");
+        return response(request);
+      },
+    };
+    await expect(new FrameSubmissionRegistry(workId, store, broker).prepare(input)).rejects.toThrow(
+      "lost freeze response",
+    );
+    const registry = new FrameSubmissionRegistry(workId, store, broker);
+    const recovered = await registry.prepare({
+      ...input,
+      profileId: "claude",
+      model: "different-model",
+    });
+    expect(requests[1]).toEqual(requests[0]);
+    expect(requests[1].profileId).toBe(input.profileId);
+    expect(requests[1].model).toBe(input.model);
+    expect((await registry.prepare({ ...input, model: "another-model" })).messageId).toBe(
+      recovered.messageId,
+    );
+    expect(requests).toHaveLength(2);
+  });
+  it("fingerprints actual wire attachments and image bytes", async () => {
+    const a = await fingerprintFrameSubmission({
+      attachments: [{ text: "asset snapshot" }],
+      images: [{ data: "AAAA" }],
+    });
+    expect(a).toMatch(/^[a-f0-9]{64}$/);
+    expect(
+      await fingerprintFrameSubmission({
+        attachments: [{ text: "asset snapshot" }],
+        images: [{ data: "BBBB" }],
+      }),
+    ).not.toBe(a);
+  });
+});
