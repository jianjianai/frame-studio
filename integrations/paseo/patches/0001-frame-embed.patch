@@ -0,0 +1,65 @@
+import type { AsyncStorageStatic } from "@react-native-async-storage/async-storage";
+
+export function createScopedAsyncStorage(
+  storage: AsyncStorageStatic,
+  prefix: string,
+): AsyncStorageStatic {
+  if (!prefix) return storage;
+  const scoped: AsyncStorageStatic = {
+    ...storage,
+    getItem: (key, callback) => storage.getItem(prefix + key, callback),
+    setItem: (key, value, callback) => storage.setItem(prefix + key, value, callback),
+    removeItem: (key, callback) => storage.removeItem(prefix + key, callback),
+    mergeItem: (key, value, callback) => storage.mergeItem(prefix + key, value, callback),
+    async getAllKeys(callback) {
+      try {
+        const all = await storage.getAllKeys();
+        const keys = all
+          .filter((key) => key.startsWith(prefix))
+          .map((key) => key.slice(prefix.length));
+        callback?.(null, keys);
+        return keys;
+      } catch (error) {
+        if (!(error instanceof Error)) throw error;
+        callback?.(error);
+        throw error;
+      }
+    },
+    async clear(callback) {
+      const keys = await storage.getAllKeys();
+      await storage.multiRemove(keys.filter((key) => key.startsWith(prefix)));
+      callback?.(null);
+    },
+    async multiGet(keys, callback) {
+      try {
+        const rows = await storage.multiGet(keys.map((key) => prefix + key));
+        const result: [string, string | null][] = rows.map(([key, value]) => [
+          key.slice(prefix.length),
+          value,
+        ]);
+        callback?.(null, result);
+        return result;
+      } catch (error) {
+        if (!(error instanceof Error)) throw error;
+        callback?.([error]);
+        throw error;
+      }
+    },
+    multiSet: (rows, callback) =>
+      storage.multiSet(
+        rows.map(([key, value]) => [prefix + key, value]),
+        callback,
+      ),
+    multiRemove: (keys, callback) =>
+      storage.multiRemove(
+        keys.map((key) => prefix + key),
+        callback,
+      ),
+    multiMerge: (rows, callback) =>
+      storage.multiMerge(
+        rows.map(([key, value]) => [prefix + key, value]),
+        callback,
+      ),
+  };
+  return scoped;
+}
