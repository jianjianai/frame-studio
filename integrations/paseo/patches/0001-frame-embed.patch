diff --git a/packages/app/src/frame/bridge.web.ts b/packages/app/src/frame/bridge.web.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cff541590eb34da7570fd366e2a99d475eab46ad
--- /dev/null
+++ b/packages/app/src/frame/bridge.web.ts
@@ -0,0 +1,184 @@
+import { getFrameBootstrap } from "./bootstrap";
+import { FrameEmbedError } from "./bootstrap-model";
+import {
+  FrameOperationSchema,
+  FramePortMessageSchema,
+  type FrameOperation,
+  type FrameBootstrap,
+} from "../../../../plugin-examples/frame/shared/bridge";
+import type { FrameClientBridge } from "../../../../plugin-examples/frame/client/bridge";
+
+interface PendingRequest {
+  resolve: (value: unknown) => void;
+  reject: (error: Error) => void;
+  timer: ReturnType<typeof setTimeout>;
+}
+const MAX_PENDING_REQUESTS = 32;
+const MAX_MESSAGE_BYTES = 2_100_000;
+const REQUEST_TIMEOUT_MS = 30_000;
+type FrameListener = (event: string, payload: unknown) => void;
+
+class FrameBridge implements FrameClientBridge {
+  private readonly port: MessagePort;
+  private readonly pending = new Map<string, PendingRequest>();
+  private readonly listeners = new Set<FrameListener>();
+  private readonly connected: Promise<void>;
+  private closed = false;
+  private readonly listenerController = new AbortController();
+  private connectedSuccessfully = false;
+  private readonly connectTimer: ReturnType<typeof setTimeout>;
+  private readonly resolveConnected: () => void;
+  private readonly rejectConnected: (error: Error) => void;
+
+  constructor(private readonly config: FrameBootstrap) {
+    const channel = new MessageChannel();
+    this.port = channel.port1;
+    const connected = Promise.withResolvers<void>();
+    this.connected = connected.promise;
+    this.resolveConnected = connected.resolve;
+    this.rejectConnected = connected.reject;
+    this.connectTimer = setTimeout(
+      () =>
+        this.dispose(
+          new FrameEmbedError(
+            "bridge_timeout",
+            "Frame has not connected. Reopen this work to retry.",
+          ),
+        ),
+      5000,
+    );
+    this.port.addEventListener("message", (event) => this.receive(event.data), {
+      signal: this.listenerController.signal,
+    });
+    this.port.addEventListener(
+      "messageerror",
+      () =>
+        this.dispose(
+          new FrameEmbedError("bridge_transfer", "The Frame connection could not read a message."),
+        ),
+      { signal: this.listenerController.signal },
+    );
+    this.port.start();
+    window.parent.postMessage(
+      {
+        type: "frame-paseo-connect",
+        version: 1,
+        workId: config.workId,
+        nonce: config.nonce,
+      },
+      config.parentOrigin,
+      [channel.port2],
+    );
+    void this.connected.catch(() => {});
+  }
+
+  private receive(value: unknown): void {
+    if (this.closed) return;
+    const result = FramePortMessageSchema.safeParse(value);
+    if (!result.success) return;
+    const message = result.data;
+    if (message.type === "connected") {
+      if (message.workId !== this.config.workId || message.nonce !== this.config.nonce) {
+        this.dispose(
+          new FrameEmbedError("bridge_scope", "The Frame connection belongs to a different work."),
+        );
+        return;
+      }
+      this.connectedSuccessfully = true;
+      clearTimeout(this.connectTimer);
+      this.resolveConnected();
+      return;
+    }
+    if (!this.connectedSuccessfully) return;
+    if (message.type === "event") {
+      if (message.event === "disposed") {
+        this.dispose(new FrameEmbedError("bridge_disposed", "This Frame work has closed."));
+        return;
+      }
+      for (const listener of this.listeners) listener(message.event, message.payload);
+      return;
+    }
+    const row = this.pending.get(message.id);
+    if (!row) return;
+    clearTimeout(row.timer);
+    this.pending.delete(message.id);
+    if (message.ok) row.resolve(message.payload);
+    else row.reject(new FrameEmbedError(message.error.code, message.error.message));
+  }
+
+  async request(op: FrameOperation, payload: unknown): Promise<unknown> {
+    FrameOperationSchema.parse(op);
+    const length = new TextEncoder().encode(JSON.stringify(payload)).byteLength;
+    if (length > MAX_MESSAGE_BYTES)
+      throw new FrameEmbedError("bridge_size", "The Frame reference is too large.");
+    await this.connected;
+    if (this.closed) throw new FrameEmbedError("bridge_closed", "This Frame work has closed.");
+    if (this.pending.size >= MAX_PENDING_REQUESTS)
+      throw new FrameEmbedError(
+        "bridge_busy",
+        "Frame is processing too many requests. Retry when the current request finishes.",
+      );
+    const id = crypto.randomUUID();
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this.pending.delete(id);
+        reject(
+          new FrameEmbedError(
+            "request_timeout",
+            "Frame did not finish this request. You can retry.",
+          ),
+        );
+      }, REQUEST_TIMEOUT_MS);
+      this.pending.set(id, { resolve, reject, timer });
+      this.port.postMessage({ type: "request", id, op, payload }, []);
+    });
+  }
+
+  subscribe(listener: FrameListener): () => void {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  }
+
+  dispose(error = new FrameEmbedError("bridge_closed", "This Frame work has closed.")): void {
+    if (this.closed) return;
+    this.closed = true;
+    clearTimeout(this.connectTimer);
+    this.rejectConnected(error);
+    for (const row of this.pending.values()) {
+      clearTimeout(row.timer);
+      row.reject(error);
+    }
+    this.pending.clear();
+    this.listeners.clear();
+    this.listenerController.abort();
+    this.port.close();
+  }
+}
+
+let bridge: FrameBridge | null = null;
+export function getFrameBridge(): FrameClientBridge | null {
+  const config = getFrameBootstrap();
+  if (!config) return null;
+  bridge ??= new FrameBridge(config);
+  return bridge;
+}
+export function installFrameBridge(): () => void {
+  const current = getFrameBridge();
+  if (!current) return () => {};
+  Reflect.set(globalThis, "__PASEO_FRAME_BRIDGE__", {
+    request: (op: FrameOperation, payload: unknown) => current.request(op, payload),
+    subscribe: (listener: FrameListener) => current.subscribe(listener),
+  });
+  const dispose = () => {
+    bridge?.dispose();
+    bridge = null;
+    Reflect.deleteProperty(globalThis, "__PASEO_FRAME_BRIDGE__");
+  };
+  window.addEventListener("pagehide", dispose, { once: true });
+  return () => {
+    window.removeEventListener("pagehide", dispose);
+    dispose();
+  };
+}
