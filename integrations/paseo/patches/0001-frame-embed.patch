+import { z } from "zod";
+import {
+  FrameFreezeInputSchema,
+  FrameFreezeResponseSchema,
+  FrameReviewContextSchema,
+  type FrameFreezeInput,
+  type FrameFreezeResponse,
+} from "../../../../plugin-examples/frame/shared/bridge";
+import { FrameEmbedError } from "./bootstrap-model";
+
+const PendingSubmissionSchema = z.strictObject({
+  signature: z.string().regex(/^[a-f0-9]{64}$/),
+  input: FrameFreezeInputSchema,
+  frozen: FrameFreezeResponseSchema.optional(),
+});
+const PendingSubmissionsSchema = z.array(PendingSubmissionSchema).max(8);
+type PendingSubmission = z.infer<typeof PendingSubmissionSchema>;
+export interface FrameSubmissionStorage {
+  getItem(key: string): Promise<string | null>;
+  setItem(key: string, value: string): Promise<void>;
+}
+export interface FrameSubmissionBroker {
+  readContext(): Promise<unknown>;
+  freeze(input: FrameFreezeInput): Promise<unknown>;
+}
+export interface PrepareFrameSubmissionInput {
+  agentId: string;
+  prompt: string;
+  profileId: string | null;
+  model: string | null;
+  activeTurnBehavior?: "steer" | "interrupt";
+  attachmentsFingerprint: string;
+}
+export async function fingerprintFrameSubmission(value: unknown): Promise<string> {
+  const encoded = new TextEncoder().encode(JSON.stringify(value));
+  const digest = await crypto.subtle.digest("SHA-256", encoded);
+  return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("");
+}
+export class FrameSubmissionRegistry {
+  private readonly queue = new Map<string, Promise<unknown>>();
+  constructor(
+    private readonly workId: string,
+    private readonly storage: FrameSubmissionStorage,
+    private readonly broker: FrameSubmissionBroker,
+  ) {}
+  private async exclusive<Result>(agentId: string, action: () => Promise<Result>): Promise<Result> {
+    const previous = this.queue.get(agentId) ?? Promise.resolve();
+    const operation = previous.then(action, action);
+    this.queue.set(agentId, operation);
+    try {
+      return await operation;
+    } finally {
+      if (this.queue.get(agentId) === operation) this.queue.delete(agentId);
+    }
+  }
+  private key(agentId: string): string {
+    return "@paseo:frame-submissions:" + agentId;
+  }
+  private async read(agentId: string): Promise<PendingSubmission[]> {
+    const raw = await this.storage.getItem(this.key(agentId));
+    if (raw === null) return [];
+    return PendingSubmissionsSchema.parse(JSON.parse(raw));
+  }
+  private async write(agentId: string, rows: PendingSubmission[]): Promise<void> {
+    await this.storage.setItem(this.key(agentId), JSON.stringify(rows));
+  }
+  prepare(input: PrepareFrameSubmissionInput): Promise<FrameFreezeResponse> {
+    return this.exclusive(input.agentId, async () => {
+      // Selection is frozen in the persisted envelope. A lost acknowledgement
+      // must retain its message ID even when the native picker has since changed.
+      const { profileId: _, model: __, ...contentIdentity } = input;
+      const signature = await fingerprintFrameSubmission(contentIdentity);
+      const rows = await this.read(input.agentId);
+      let row = rows.find((candidate) => candidate.signature === signature);
+      if (!row) {
+        if (rows.length === 8)
+          throw new FrameEmbedError(
+            "unresolved_messages",
+            "Resolve the previous pending messages before sending more.",
+          );
+        const context = FrameReviewContextSchema.parse(await this.broker.readContext());
+        row = { signature, input: { ...input, context, messageId: crypto.randomUUID() } };
+        rows.push(row);
+        await this.write(input.agentId, rows);
+      }
+      if (row.frozen) return row.frozen;
+      const response = FrameFreezeResponseSchema.parse(await this.broker.freeze(row.input));
+      const matchesIdentity =
+        response.workId === this.workId &&
+        response.agentId === input.agentId &&
+        response.messageId === row.input.messageId;
+      if (!matchesIdentity)
+        throw new FrameEmbedError(
+          "freeze_scope",
+          "The frozen message belongs to a different work or agent.",
+        );
+      row.frozen = response;
+      await this.write(input.agentId, rows);
+      return response;
+    });
+  }
+  accepted(agentId: string, messageId: string): Promise<void> {
+    return this.exclusive(agentId, async () => {
+      const rows = await this.read(agentId);
+      await this.write(
+        agentId,
+        rows.filter((row) => row.input.messageId !== messageId),
+      );
+    });
+  }
+}
