+import { useEffect, useRef } from "react";
+import { useSessionStore } from "@/stores/session-store";
+import type { UserComposerAttachment } from "@/attachments/types";
+import { createPluginResourceAttachment } from "@/plugins/attachments/model";
+import { getFrameBootstrap } from "./bootstrap";
+import { getFrameBridge } from "./bridge";
+import { FrameContextAttachmentEventSchema } from "../../../../plugin-examples/frame/shared/bridge";
+
+export function useFrameComposer(input: {
+  serverId: string;
+  workspaceId?: string | null;
+  agentId: string;
+  isActiveComposer: boolean;
+  attachments: UserComposerAttachment[];
+  onChangeAttachments: (attachments: UserComposerAttachment[]) => void;
+}): void {
+  const latest = useRef(input);
+  latest.current = input;
+  useEffect(() => {
+    const config = getFrameBootstrap();
+    const bridge = getFrameBridge();
+    if (!config || !bridge || input.serverId !== config.serverId || !input.workspaceId) return;
+    return bridge.subscribe((event, payload) => {
+      if (event !== "context.attach") return;
+      const parsed = FrameContextAttachmentEventSchema.safeParse(payload);
+      if (!parsed.success || parsed.data.agentId !== latest.current.agentId) return;
+      const attachment = createPluginResourceAttachment(
+        {
+          pluginId: "frame",
+          sourceId: "frame-context",
+          sourceTitle: "Frame",
+          sourceIcon: "Film",
+        },
+        parsed.data.item,
+      );
+      const attachments = latest.current.attachments.filter(
+        (candidate) =>
+          candidate.kind !== "plugin_resource" ||
+          candidate.pluginId !== "frame" ||
+          candidate.sourceId !== "frame-context" ||
+          candidate.item.id !== attachment.item.id,
+      );
+      latest.current.onChangeAttachments([...attachments, attachment]);
+    });
+  }, [input.serverId, input.workspaceId, input.agentId]);
+  useEffect(() => {
+    const config = getFrameBootstrap();
+    const bridge = getFrameBridge();
+    if (
+      !config ||
+      !bridge ||
+      !input.isActiveComposer ||
+      input.serverId !== config.serverId ||
+      !input.workspaceId
+    )
+      return;
+    void bridge
+      .request("context.subscribe", {
+        agentId: input.agentId,
+        native: Boolean(
+          useSessionStore.getState().sessions[input.serverId]?.agents.has(input.agentId),
+        ),
+      })
+      .catch((error) => {
+        console.error("[Frame] Could not observe the active preview context", error);
+      });
+  }, [input.serverId, input.workspaceId, input.agentId, input.isActiveComposer]);
+}
diff --git a/packages/app/src/frame/creation-model.test.ts b/packages/app/src/frame/creation-model.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dfb5cb8c95145873e15bc520aa8227d166f29ae9
--- /dev/null
+++ b/packages/app/src/frame/creation-model.test.ts
@@ -0,0 +1,104 @@
+import { describe, it, expect, vi } from "vitest";
+import { FrameFreezeInputSchema } from "../../../../plugin-examples/frame/shared/bridge";
+import { FrameCreationRegistry } from "./creation-model";
+function fixture() {
+  const values = new Map<string, string>();
+  const storage = {
+    getItem: async (key: string) => values.get(key) ?? null,
+    setItem: async (key: string, value: string) => {
+      values.set(key, value);
+    },
+  };
+  let time = 2.5;
+  const readContext = vi.fn(async () => ({ time }));
+  return {
+    values,
+    storage,
+    readContext,
+    setTime: (next: number) => {
+      time = next;
+    },
+  };
+}
+function ops() {
+  let lost = true;
+  const ids: string[] = [];
+  const freeze = vi.fn(async (value: unknown) => {
+    const input = FrameFreezeInputSchema.parse(value);
+    return {
+      version: 1,
+      workId: "11111111-1111-4111-8111-111111111111",
+      agentId: input.agentId,
+      messageId: input.messageId,
+      intentHash: "a".repeat(64),
+      context: input.context,
+      reviewReference: { status: "unversioned" },
+      attachment: { type: "text", mimeType: "text/plain", text: "frozen at " + input.context.time },
+    };
+  });
+  return {
+    ids,
+    prompt: "first",
+    attachmentsFingerprint: "b".repeat(64),
+    create: vi.fn(async (id: string) => {
+      ids.push(id);
+      return { agentId: id, profileId: "codex", model: "model", result: id };
+    }),
+    freeze,
+    send: vi.fn(async () => {
+      if (lost) {
+        lost = false;
+        throw new Error("lost acknowledgement");
+      }
+    }),
+  };
+}
+describe("Frame first native conversation message", () => {
+  it("persists context before native creation and replays the same blank agent/frozen message after reload", async () => {
+    const f = fixture(),
+      o = ops();
+    const registry = new FrameCreationRegistry(
+      "11111111-1111-4111-8111-111111111111",
+      f.storage,
+      f.readContext,
+    );
+    await expect(registry.run("draft-one", { prompt: "first" }, o)).rejects.toThrow(
+      "lost acknowledgement",
+    );
+    f.setTime(20);
+    const fresh = new FrameCreationRegistry(
+      "11111111-1111-4111-8111-111111111111",
+      f.storage,
+      f.readContext,
+    );
+    await fresh.run("draft-one", { prompt: "first" }, o);
+    expect(new Set(o.ids).size).toBe(1);
+    expect(o.freeze).toHaveBeenCalledTimes(1);
+    expect(FrameFreezeInputSchema.parse(o.freeze.mock.calls[0][0]).context.time).toBe(2.5);
+    expect(o.send.mock.calls[0]).toEqual(o.send.mock.calls[1]);
+    expect(f.readContext).toHaveBeenCalledTimes(1);
+    await fresh.run("draft-one", { prompt: "first" }, o);
+    expect(o.send).toHaveBeenCalledTimes(2);
+  });
+  it("refuses changed creation input instead of changing an unresolved first message", async () => {
+    const f = fixture(),
+      o = ops(),
+      r = new FrameCreationRegistry(
+        "11111111-1111-4111-8111-111111111111",
+        f.storage,
+        f.readContext,
+      );
+    await r.run("draft", { prompt: "first" }, o).catch(() => {});
+    await expect(r.run("draft", { prompt: "changed" }, o)).rejects.toThrow("different input");
+    expect(o.create).toHaveBeenCalledTimes(1);
+  });
+  it("never creates an agent when the trusted context is unavailable", async () => {
+    const f = fixture(),
+      o = ops(),
+      r = new FrameCreationRegistry("11111111-1111-4111-8111-111111111111", f.storage, async () => {
+        throw new Error("bridge missing");
+      });
+    await expect(r.run("draft", {}, o)).rejects.toThrow("bridge missing");
+    expect(o.create).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/app/src/frame/creation-model.ts b/packages/app/src/frame/creation-model.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b62264dc412f81b8de908a52aee2bb07a1b4e35f
--- /dev/null
+++ b/packages/app/src/frame/creation-model.ts
@@ -0,0 +1,131 @@
+import { z } from "zod";
+import {
+  FrameReviewContextSchema,
+  FrameFreezeInputSchema,
+  FrameFreezeResponseSchema,
+  type FrameFreezeResponse,
+} from "../../../../plugin-examples/frame/shared/bridge";
+import { fingerprintFrameSubmission, type FrameSubmissionStorage } from "./submission-model";
+import { FrameEmbedError } from "./bootstrap-model";
+const RowSchema = z.strictObject({
+  key: z.string().min(1).max(512),
+  signature: z.string().regex(/^[a-f0-9]{64}$/),
+  agentId: z.uuid(),
+  messageId: z.uuid(),
+  context: FrameReviewContextSchema,
+  input: FrameFreezeInputSchema.optional(),
+  frozen: FrameFreezeResponseSchema.optional(),
+  accepted: z.boolean(),
+});
+const RowsSchema = z.array(RowSchema).max(16);
+export class FrameCreationRegistry {
+  private readonly queue = new Map<string, Promise<unknown>>();
+  constructor(
+    private readonly workId: string,
+    private readonly storage: FrameSubmissionStorage,
+    private readonly readContext: () => Promise<unknown>,
+  ) {}
+  async run<Result>(
+    key: string,
+    intent: unknown,
+    operations: {
+      create: (agentId: string) => Promise<{
+        agentId: string;
+        profileId: string | null;
+        model: string | null;
+        result: Result;
+      }>;
+      prompt: string;
+      messageId?: string;
+      context?: Promise<unknown>;
+      attachmentsFingerprint: string;
+      freeze: (input: unknown) => Promise<unknown>;
+      send: (agentId: string, frozen: FrameFreezeResponse) => Promise<void>;
+    },
+  ): Promise<Result> {
+    const previous = this.queue.get(key) ?? Promise.resolve();
+    const operation = previous.then(async () => {
+      const storageKey = "@paseo:frame-creations";
+      const raw = await this.storage.getItem(storageKey);
+      const rows = raw === null ? [] : RowsSchema.parse(JSON.parse(raw));
+      const signature = await fingerprintFrameSubmission(intent);
+      let row = rows.find((item) => item.key === key);
+      if (row && row.signature !== signature)
+        throw new FrameEmbedError(
+          "creation_intent_changed",
+          "This creation is already pending with different input. Retry its original request or start a new conversation.",
+        );
+      if (!row) {
+        if (rows.length === 16) {
+          const completed = rows.findIndex((item) => item.accepted);
+          if (completed < 0)
+            throw new FrameEmbedError(
+              "unresolved_creations",
+              "Resolve the pending conversation creations before creating more.",
+            );
+          rows.splice(completed, 1);
+        }
+        row = {
+          key,
+          signature,
+          agentId: crypto.randomUUID(),
+          messageId: z.uuid().safeParse(operations.messageId).success
+            ? operations.messageId!
+            : crypto.randomUUID(),
+          context: FrameReviewContextSchema.parse(await (operations.context ?? this.readContext())),
+          accepted: false,
+        };
+        rows.push(row);
+        await this.storage.setItem(storageKey, JSON.stringify(rows));
+      }
+      const created = await operations.create(row.agentId);
+      if (created.agentId !== row.agentId)
+        throw new FrameEmbedError(
+          "creation_identity",
+          "The native conversation creation returned a different identity.",
+        );
+      if (row.accepted) return created.result;
+      if (!row.input) {
+        row.input = FrameFreezeInputSchema.parse({
+          agentId: row.agentId,
+          messageId: row.messageId,
+          prompt: operations.prompt,
+          profileId: created.profileId,
+          model: created.model,
+          context: row.context,
+          attachmentsFingerprint: operations.attachmentsFingerprint,
+        });
+        await this.storage.setItem(storageKey, JSON.stringify(rows));
+      }
+      if (!row.frozen) {
+        const frozen = FrameFreezeResponseSchema.parse(await operations.freeze(row.input));
+        if (
+          frozen.workId !== this.workId ||
+          frozen.agentId !== row.agentId ||
+          frozen.messageId !== row.messageId
+        )
+          throw new FrameEmbedError(
+            "freeze_scope",
+            "The frozen first message belongs to another work or conversation.",
+          );
+        row.frozen = frozen;
+        await this.storage.setItem(storageKey, JSON.stringify(rows));
+      }
+      await operations.send(row.agentId, row.frozen);
+      row.accepted = true;
+      // Native accepted receipts stay successful even if local persistence fails.
+      await this.storage
+        .setItem(storageKey, JSON.stringify(rows))
+        .catch((error) =>
+          console.error("[Frame] Could not persist an accepted first message", error),
+        );
+      return created.result;
+    });
+    this.queue.set(key, operation);
+    try {
+      return await operation;
+    } finally {
+      if (this.queue.get(key) === operation) this.queue.delete(key);
+    }
+  }
+}
