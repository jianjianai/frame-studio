diff --git a/packages/server/src/server/speech/providers/local/frame-shared-model-wait.ts b/packages/server/src/server/speech/providers/local/frame-shared-model-wait.ts
new file mode 100644
index 0000000..ce90a00
--- /dev/null
+++ b/packages/server/src/server/speech/providers/local/frame-shared-model-wait.ts
@@ -0,0 +1,110 @@
+import { lstat, readFile } from "node:fs/promises";
+import path from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { getSherpaOnnxModelSpec, type LocalSpeechModelId } from "./sherpa/model-catalog.js";
+
+const STATE_FILE = ".frame-speech-state.json";
+const failure =
+  "Shared speech model preparation failed; reopen the work to retry. Chat remains available.";
+
+export function isFrameSharedSpeechModelDirectory(modelsDir?: string | null): boolean {
+  const shared = process.env.FRAME_PASEO_SHARED_MODELS;
+  return (
+    process.env.FRAME_PASEO_SHARED_MODELS_READONLY === "1" &&
+    !!shared &&
+    path.isAbsolute(shared) &&
+    !!modelsDir &&
+    path.resolve(modelsDir) === path.resolve(shared)
+  );
+}
+
+async function safeStat(file: string) {
+  const value = await lstat(file).catch((error: NodeJS.ErrnoException) => {
+    if (error.code === "ENOENT") return null;
+    throw new Error(failure);
+  });
+  if (value?.isSymbolicLink()) throw new Error(failure);
+  return value;
+}
+
+async function readSharedState(modelsDir: string): Promise<{ state: string } | null> {
+  const file = path.join(modelsDir, STATE_FILE);
+  const stat = await safeStat(file);
+  if (!stat) return null;
+  if (!stat.isFile() || stat.nlink !== 1 || stat.size > 32768) throw new Error(failure);
+  try {
+    const value = JSON.parse(await readFile(file, "utf8"));
+    if (
+      !value ||
+      value.version !== 1 ||
+      !["preparing", "ready", "error"].includes(value.state) ||
+      ![value.modelIds, value.completedModelIds].every(
+        (ids) =>
+          Array.isArray(ids) &&
+          ids.length <= 20 &&
+          ids.every((id) => typeof id === "string" && id.length <= 128),
+      )
+    ) {
+      throw new Error(failure);
+    }
+    return { state: value.state };
+  } catch {
+    throw new Error(failure);
+  }
+}
+
+async function modelReady(modelsDir: string, modelId: LocalSpeechModelId): Promise<boolean> {
+  const spec = getSherpaOnnxModelSpec(modelId);
+  const base = path.join(modelsDir, spec.extractedDir);
+  if (!(await safeStat(base))?.isDirectory()) return false;
+  for (const relative of spec.requiredFiles) {
+    let current = base;
+    const parts = relative.split("/");
+    for (let index = 0; index < parts.length; index++) {
+      current = path.join(current, parts[index]!);
+      const stat = await safeStat(current);
+      if (
+        !stat ||
+        (index < parts.length - 1
+          ? !stat.isDirectory()
+          : !(stat.isDirectory() || (stat.isFile() && stat.size > 0)))
+      )
+        return false;
+    }
+  }
+  return true;
+}
+
+/** Frame consumers never download or write to the controller-owned read-only shared cache. */
+export async function waitForFrameSharedSpeechModels(options: {
+  modelsDir: string;
+  modelIds: LocalSpeechModelId[];
+  signal?: AbortSignal;
+}): Promise<Record<LocalSpeechModelId, string>> {
+  const ids = [...new Set(options.modelIds)];
+  for (;;) {
+    options.signal?.throwIfAborted();
+    // Defaults can become usable while an optional model is still preparing, or has failed.
+    if ((await Promise.all(ids.map((id) => modelReady(options.modelsDir, id)))).every(Boolean)) {
+      options.signal?.throwIfAborted();
+      return Object.fromEntries(
+        ids.map((id) => [
+          id,
+          path.join(options.modelsDir, getSherpaOnnxModelSpec(id).extractedDir),
+        ]),
+      ) as Record<LocalSpeechModelId, string>;
+    }
+    const state = await readSharedState(options.modelsDir);
+    if (state?.state === "error") throw new Error(failure);
+    await delay(250, undefined, { signal: options.signal });
+  }
+}
+
+/** Only Frame's shared producer retry may restart a failed read-only wait. */
+export async function shouldRetryFrameSharedSpeechWait(
+  modelsDir?: string | null,
+): Promise<boolean> {
+  if (!isFrameSharedSpeechModelDirectory(modelsDir)) return false;
+  const state = await readSharedState(modelsDir!);
+  return state?.state === "preparing" || state?.state === "ready";
+}
