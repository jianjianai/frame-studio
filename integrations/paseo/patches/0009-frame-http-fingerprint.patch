+        hash.update(encoded.subarray(offset, offset + 64 * 1024));
+        if (offset + 64 * 1024 < encoded.byteLength && now() - started >= 8) {
+          await new Promise<void>((resolve) => setTimeout(resolve, 0));
+          started = now();
+        }
+      }
+      digest = hash.digest();
+    } finally {
+      hash.clean();
+    }
+  }
+  return Array.from(digest, (byte) => byte.toString(16).padStart(2, "0")).join("");
