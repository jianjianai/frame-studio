+
+describe("Frame submission SHA-256 on ordinary HTTP", () => {
+  const values = [
+    {},
+    { prompt: "中文 🖼️", attachments: [{ text: "引用画面 0.5–1.5 秒" }] },
+    { images: [{ data: "AAAA".repeat(200000), mimeType: "image/png" }] },
+  ];
+  it("matches native SHA-256 for the exact JSON UTF-8 wire bytes", async () => {
+    const digest = vi.fn((algorithm: string, data: BufferSource) =>
+      webcrypto.subtle.digest(algorithm, data),
+    );
+    try {
+      vi.stubGlobal("crypto", { subtle: { digest } });
+      for (const value of values) {
+        const expected = createHash("sha256").update(JSON.stringify(value)).digest("hex");
+        expect(await fingerprintFrameSubmission(value)).toBe(expected);
+      }
+      expect(digest).toHaveBeenCalledTimes(values.length);
+    } finally {
+      vi.unstubAllGlobals();
+    }
+  });
+  it("keeps the same full SHA-256 when the browser has no subtle interface", async () => {
+    try {
+      vi.stubGlobal("crypto", { getRandomValues: webcrypto.getRandomValues.bind(webcrypto) });
+      for (const value of values) {
+        const expected = createHash("sha256").update(JSON.stringify(value)).digest("hex");
+        expect(await fingerprintFrameSubmission(value)).toBe(expected);
+      }
+      expect(await fingerprintFrameSubmission({ images: [{ data: "AAAA" }] })).not.toBe(
+        await fingerprintFrameSubmission({ images: [{ data: "BBBB" }] }),
+      );
+    } finally {
+      vi.unstubAllGlobals();
+    }
+  });
+});
