@@ -0,0 +1,87 @@
+import http from "node:http";
+import fs from "node:fs/promises";
+import path from "node:path";
+import { tmpdir } from "node:os";
+import { afterEach, expect, test } from "vitest";
+import { guardFrameMessageSelection } from "./frame-message-selection.js";
+import { MessageReceipts } from "./message-receipts/index.js";
+import { AgentManager } from "./agent/agent-manager.js";
+
+const cleanups: Array<() => Promise<void>> = [];
+afterEach(async () => { for (const cleanup of cleanups.splice(0).reverse()) await cleanup(); });
+async function fixture() {
+  const directory = await fs.mkdtemp(path.join(tmpdir(), "frame-native-selection-"));
+  cleanups.push(() => fs.rm(directory, { recursive: true, force: true }));
+  let frozen = true, requests = 0;
+  const server = http.createServer((req, res) => {
+    requests++;
+    expect(req.headers.authorization).toBe("Bearer work-private-test");
+    expect(req.url).toBe("/work/messages/message/selection?agentId=agent");
+    res.setHeader("content-type", "application/json");
+    res.end(JSON.stringify(frozen ? { version: 1, frozen: true,
+      selection: { provider: "frame-profile", model: "original" } } : { version: 1, frozen: false }));
+  });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  cleanups.push(() => new Promise<void>(resolve => server.close(() => resolve())));
+  const previous = { url: process.env.FRAME_PASEO_URL, token: process.env.FRAME_PASEO_TOKEN };
+  process.env.FRAME_PASEO_URL = "http://127.0.0.1:" + (server.address() as { port: number }).port + "/work";
+  process.env.FRAME_PASEO_TOKEN = "work-private-test";
+  cleanups.push(async () => {
+    if (previous.url === undefined) delete process.env.FRAME_PASEO_URL; else process.env.FRAME_PASEO_URL = previous.url;
+    if (previous.token === undefined) delete process.env.FRAME_PASEO_TOKEN; else process.env.FRAME_PASEO_TOKEN = previous.token;
+  });
+  let model = "changed", deliveries = 0;
+  const receipts = new MessageReceipts(directory);
+  const input = { agentId: "agent", messageId: "message", request: { text: "frozen message" },
+    prepare: () => guardFrameMessageSelection({ agentId: "agent", messageId: "message",
+      selection: () => ({ provider: "frame-profile", model }) }),
+    send: async () => { deliveries++; } };
+  return { receipts, input, requests: () => requests, deliveries: () => deliveries,
+    setModel: (value: string) => { model = value; }, setFrozen: (value: boolean) => { frozen = value; } };
+}
+test("Changed frozen selection is rejected before pending receipt; completed lost-ack replay still succeeds", async () => {
+  const f = await fixture();
+  await expect(f.receipts.send(f.input)).rejects.toThrow("模型或提供商已改变");
+  expect(f.deliveries()).toBe(0);
+  f.setModel("original");
+  await f.receipts.send(f.input);
+  expect(f.deliveries()).toBe(1);
+  f.setModel("changed");
+  await f.receipts.send(f.input);
+  expect(f.requests()).toBe(2);
+  expect(f.deliveries()).toBe(1);
+});
+test("Unknown native delivery outcome is preserved ahead of selection checks; unfrozen CLI messages remain native", async () => {
+  const f = await fixture();
+  f.setModel("original");
+  await expect(f.receipts.send({ ...f.input, send: async () => { throw Error("lost provider ack"); } })).rejects.toThrow("lost provider ack");
+  f.setModel("changed");
+  await expect(f.receipts.send(f.input)).rejects.toThrow("agent_request_outcome_unknown");
+  expect(f.requests()).toBe(1);
+  f.setFrozen(false);
+  await f.receipts.send({ ...f.input, messageId: "cli-message" });
+  expect(f.deliveries()).toBe(1);
+});
+test("Native model mutation waits until the frozen receipt prepare and send lane completes", async () => {
+  const f = await fixture(); f.setModel("original");
+  const manager = Object.create(AgentManager.prototype) as AgentManager;
+  const agent = { config: { model: "original" }, runtimeInfo: null,
+    session: { setModel: async (value: string) => { f.setModel(value); } } };
+  Object.assign(manager, { selectionMutationTails: new Map(), requireSessionAgent: () => agent,
+    drainSessionEvents: async () => {}, refreshSessionPersistence: () => {}, touchUpdatedAt: () => {}, emitState: () => {} });
+  let release!: () => void;
+  const blocked = new Promise<void>(resolve => { release = resolve; });
+  let entered!: () => void;
+  const preparing = new Promise<void>(resolve => { entered = resolve; });
+  const sending = manager.withAgentSelectionMutation("agent", () => f.receipts.send({
+    ...f.input, prepare: async () => { entered(); await blocked; await f.input.prepare(); },
+  }));
+  await preparing;
+  const changing = manager.setAgentModel("agent", "changed");
+  await Promise.resolve();
+  expect(agent.config.model).toBe("original");
+  release();
+  await Promise.all([sending, changing]);
+  expect(f.deliveries()).toBe(1);
+  expect(agent.config.model).toBe("changed");
+});
