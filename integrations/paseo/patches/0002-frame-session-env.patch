diff --git a/packages/server/src/server/frame-message-selection.ts b/packages/server/src/server/frame-message-selection.ts
new file mode 100644
index 0000000..623dc58
--- /dev/null
+++ b/packages/server/src/server/frame-message-selection.ts
@@ -0,0 +1,29 @@
+import { z } from "zod";
+
+const SelectionResponse = z.discriminatedUnion("frozen", [
+  z.object({ version: z.literal(1), frozen: z.literal(false) }),
+  z.object({ version: z.literal(1), frozen: z.literal(true),
+    selection: z.object({ provider: z.string().min(1), model: z.string().nullable() }) }),
+]);
+
+/** Runs only after native receipt recovery, before the pending receipt and provider send. */
+export async function guardFrameMessageSelection(input: {
+  agentId: string; messageId: string;
+  selection: () => { provider: string; model?: string | null };
+  signal?: AbortSignal;
+}): Promise<void> {
+  const base = process.env.FRAME_PASEO_URL;
+  if (!base) return;
+  const url = new URL(base.replace(/\/$/, "") + "/messages/" + encodeURIComponent(input.messageId) + "/selection");
+  url.searchParams.set("agentId", input.agentId);
+  const response = await fetch(url, {
+    headers: { authorization: "Bearer " + process.env.FRAME_PASEO_TOKEN },
+    signal: input.signal ? AbortSignal.any([input.signal, AbortSignal.timeout(10000)]) : AbortSignal.timeout(10000),
+  });
+  if (!response.ok) throw new Error("FRAME 冻结选择暂时无法确认，请保持原消息并重试。");
+  const frozen = SelectionResponse.parse(await response.json());
+  if (!frozen.frozen) return; // Official CLI/API messages can use native delivery without a FRAME attachment.
+  const current = input.selection();
+  if (frozen.selection.provider !== current.provider || frozen.selection.model !== (current.model ?? null))
+    throw new Error("这条消息冻结后模型或提供商已改变，请恢复原选择重试，或明确创建一条新消息。");
+}
