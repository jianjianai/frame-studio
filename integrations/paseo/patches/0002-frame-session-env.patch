+  /** Serializes model changes with a frozen message's receipt preparation and send. */
+  async withAgentSelectionMutation<T>(agentId: string, mutation: () => Promise<T>): Promise<T> {
+    const previous = this.selectionMutationTails.get(agentId) ?? Promise.resolve();
+    const result = previous.catch(() => undefined).then(mutation);
+    const tail = result.then(() => undefined, () => undefined);
+    this.selectionMutationTails.set(agentId, tail);
+    void tail.finally(() => {
+      if (this.selectionMutationTails.get(agentId) === tail) this.selectionMutationTails.delete(agentId);
+    });
+    return result;
+  }
