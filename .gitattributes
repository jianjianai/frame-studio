* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.cmd text eol=crlf
*.png binary
*.webp binary
*.wav binary
*.wasm binary
# Keep native source patches byte-stable across Windows and Linux; blank context lines retain their prefix.
integrations/t3-code/patches/*.patch text eol=lf whitespace=-blank-at-eol
