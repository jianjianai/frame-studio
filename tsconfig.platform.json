{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "studio/chat-draft.js",
    "studio/task-events.js",
    "src/contracts/*.mjs",
    "src/contracts/*.ts",
    "studio/realtime.ts",
    "server/operation-registry.mjs"
  ]
}
